# ─────────────────────────────────────────────────────────────────────────────
# Househelp Tracker — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── NEVER COMMIT THESE ───────────────────────────────────────────────────────

# Real environment files with actual API keys
.env
.env.local
.env.production
.env.*.local

# Any file accidentally containing API keys
secrets.txt
keys.txt
config.local.*


# ── OS FILES ─────────────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Windows
desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ── EDITOR & IDE ─────────────────────────────────────────────────────────────

# VS Code
.vscode/
*.code-workspace

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#


# ── NODE (if ever introduced) ────────────────────────────────────────────────

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity


# ── BUILD OUTPUT (if ever introduced) ────────────────────────────────────────

dist/
build/
out/
.cache/


# ── LOGS ─────────────────────────────────────────────────────────────────────

logs/
*.log


# ── MISC ─────────────────────────────────────────────────────────────────────

# Temporary files
*.tmp
*.temp
*.bak

# Compressed archives
*.zip
*.tar.gz
*.rar
