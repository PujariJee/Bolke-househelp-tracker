# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Househelp Tracker — Environment Variables Template
#
# This project does NOT use a .env file at runtime.
# All configuration is entered by the user through the in-app Settings UI
# and stored in the browser's localStorage.
#
# This file exists purely for documentation purposes — to show what credentials
# are needed and where to get them.
#
# DO NOT commit a real .env file with actual keys to this repository.
# ─────────────────────────────────────────────────────────────────────────────


# ── GROQ API KEY ─────────────────────────────────────────────────────────────
# Used for: Voice transcription (Whisper) + Chat responses (LLaMA 3.3)
# Get it:   https://console.groq.com → API Keys → Create API Key
# Format:   Starts with gsk_
# Cost:     Free tier — no credit card required
#
GROQ_API_KEY=gsk_your_key_here


# ── GOOGLE APPS SCRIPT WEB APP URL ───────────────────────────────────────────
# Used for: Permanent cloud storage (save/load worker and absence data)
# Get it:   https://script.google.com → New project → Deploy → Web app
#           Set "Who has access" to Anyone → Copy the Web App URL
# Format:   https://script.google.com/macros/s/.../exec
# Cost:     Free — included with any Google account
#
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_script_id/exec
