# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Bolke — Vercel Environment Variables
#
# Set these in your Vercel project dashboard:
#   vercel.com → Your Project → Settings → Environment Variables
#
# DO NOT commit a real .env file with actual values to this repository.
# The Supabase anon key is safe to use client-side, but keep GROQ_API_KEY
# and DEMO_TOKEN server-side only (they live in Vercel, never in HTML).
# ─────────────────────────────────────────────────────────────────────────────


# ── GROQ API KEY ─────────────────────────────────────────────────────────────
# Used for: Voice transcription (Whisper) + Chat responses (LLaMA 3.3)
# Get it:   https://console.groq.com → API Keys → Create API Key
# Format:   Starts with gsk_
# Cost:     Free tier — no credit card required
#
GROQ_API_KEY=gsk_your_key_here


# ── DEMO TOKEN ───────────────────────────────────────────────────────────────
# Used for: Distinguishing the household owner from portfolio visitors
# Format:   Any strong random string (e.g. openssl rand -hex 24)
# Usage:    Share the app as: https://your-app.vercel.app?token=YOUR_TOKEN
#           Token is saved to localStorage; URL stays clean after first visit.
# Security: Only /api/chat requires this. /api/voice (Whisper) is open to all.
#
DEMO_TOKEN=your_secret_token_here


# ─────────────────────────────────────────────────────────────────────────────
# Supabase credentials are entered once via the in-app Settings UI (gear icon)
# and stored in localStorage. The anon key is safe to store client-side
# (it's designed to be public — Supabase RLS policies control data access).
# ─────────────────────────────────────────────────────────────────────────────
#
# SUPABASE_URL=https://xxxx.supabase.co       (stored in localStorage by user)
# SUPABASE_ANON_KEY=eyJh...                   (stored in localStorage by user)
